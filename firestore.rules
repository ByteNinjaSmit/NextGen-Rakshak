rules_version = '2';

// Rakshak Firestore rules.
// Everyone touching data must be authenticated:
//   - Police officers on the web kiosk sign in with Google.
//   - Volunteer devices sign in with Google (anonymous is a demo fallback).
//
// Authentication is not authorisation. Any Google account can sign in, so
// alert writes are gated on a `police` custom claim, granted only to
// allow-listed officers by the claimOfficerRole Cloud Function.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isPolice() {
      return signedIn() && request.auth.token.role == 'police';
    }

    // Missing-child alerts. Filed and resolved by the kiosk; read by every
    // signed-in device so volunteers can match against them.
    match /alerts/{alertId} {
      allow read: if signedIn();
      // An alert must name the officer who filed it, and that officer must be
      // the caller — attribution cannot be forged onto another account.
      allow create: if isPolice()
                    && request.resource.data.createdBy.uid == request.auth.uid;
      allow update: if isPolice();
      allow delete: if false;
    }

    // Match sightings reported by volunteers.
    match /matches/{matchId} {

      // Shape and value checks for a new sighting. Keep in step with
      // FirestoreMatchSource.submit() in the Android app.
      function validMatch() {
        let d = request.resource.data;
        return d.keys().hasAll([
                 'alertId', 'childName', 'imageUrl', 'volunteerId',
                 'volunteerRole', 'confidence', 'location', 'status', 'timestamp'
               ])
               && d.keys().hasOnly([
                    'alertId', 'childName', 'imageUrl', 'volunteerId',
                    'volunteerRole', 'confidence', 'location', 'status',
                    'timestamp', 'relayedBy'
                  ])
               && d.alertId is string
               && d.childName is string
               && d.imageUrl is string
               && d.volunteerId is string
               && d.volunteerRole is string
               && d.confidence is number
               && d.confidence >= 0 && d.confidence <= 1
               && d.location is latlng
               && d.status == 'pending'
               // Server clock, not the device's: a sighting cannot be back- or
               // forward-dated to reorder the kiosk's feed.
               && d.timestamp == request.time
               && exists(/databases/$(database)/documents/alerts/$(d.alertId));
      }

      // A sighting must name its author.
      //
      // Either the caller reported it themselves, or — the mesh case — the
      // caller is relaying it for a volunteer with no internet, and says so.
      // FR-10 makes that second path essential: the reporting device is offline
      // by definition, so the write reaches Firestore from a different account
      // than the one in `volunteerId`. A relayed sighting is therefore only as
      // trustworthy as the mesh it crossed, which is exactly why it is stamped
      // rather than waved through — `relayedBy` is unforgeable even though
      // `volunteerId` is not, so the kiosk can always tell the two apart.
      function attributed() {
        let d = request.resource.data;
        return d.volunteerId == request.auth.uid
               || (d.keys().hasAny(['relayedBy']) && d.relayedBy == request.auth.uid);
      }

      allow read: if signedIn();

      // A sighting is evidence: it sends officers to a location and closes a
      // case. Without these checks any signed-in account could post a match
      // naming another volunteer as its author, against an alert that does not
      // exist, at coordinates of its choosing — so the record could neither be
      // trusted nor traced back.
      allow create: if signedIn() && validMatch() && attributed();

      // Only the kiosk changes a match's status, and only its status: the
      // reporter, location and confidence are what the record is for and must
      // not be editable after the fact. (The Cloud Function that blanks
      // imageUrl on resolution uses the Admin SDK and bypasses this.)
      allow update: if isPolice()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status'])
                    && request.resource.data.status in ['pending', 'dispatched', 'accepted', 'dismissed'];

      allow delete: if false;
    }

    // Volunteer profiles: a user may only write their own document.
    // A police account may not also register as a volunteer device — the mirror
    // of the volunteer check inside claimOfficerRole. One account, one role.
    match /volunteers/{uid} {
      allow read: if signedIn();
      allow write: if signedIn()
                   && request.auth.uid == uid
                   && !isPolice();
    }

    // Officer directory. Created and kept current by claimOfficerRole with the
    // Admin SDK, which bypasses these rules; the kiosk only reads it and edits
    // its own contact fields.
    match /officers/{uid} {
      // Officers can see each other (for attribution on alerts/dispatch), but
      // volunteers cannot enumerate police accounts.
      allow read: if isPolice();

      // An officer may edit only their own profile, and only the display fields.
      // uid / email / role / createdAt / lastLoginAt stay server-owned, so a
      // client cannot forge an identity or grant itself a role through the doc.
      allow update: if isPolice()
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'phone', 'station', 'badgeNumber', 'fcmToken', 'updatedAt']);

      // Records are created by the Cloud Function on sign-in, never by a client.
      allow create, delete: if false;
    }

    // Legacy officer allow-list. claimOfficerRole no longer reads it (officers
    // self-register), so nothing may touch it from a client.
    match /allowedOfficers/{email} {
      allow read, write: if false;
    }
  }
}
