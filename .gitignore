# Monorepo root ignore. Each sub-project also has its own .gitignore;
# the patterns here are repo-wide safety nets (no leading slash = match at any depth).

# ---- Secrets: never commit ----
.env
.env.local
.env*.local
google-services.json
serviceAccount*.json
*.pem
*.jks
*.keystore
local.properties

# ---- Dependencies / build output ----
node_modules/
.pnp
.pnp.js
.next/
out/
dist/
build/
.gradle/
functions/lib/
next-env.d.ts
*.tsbuildinfo

# ---- ML model weights: large + licensed, generated by scripts/convert_models.py ----
*.tflite
functions/model/*.bin
functions/model/model.json

# ---- Python (scripts/) ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- Android artifacts ----
*.iml
*.apk
*.aab
captures/
.externalNativeBuild
.cxx

# ---- Local AI assistant context (not for publication) ----
CLAUDE.md

# ---- Tooling / editor / OS ----
.idea/
.vscode/
.DS_Store
Thumbs.db
.claude/settings.local.json
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
.firebase/
